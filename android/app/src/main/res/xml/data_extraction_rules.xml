<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Google et transfert vers un nouveau téléphone (Android 12 et plus) :
     le coffre chiffré est inclus, la clé d'empreinte (liée à ce téléphone) est exclue. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="coffre_biometric.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="coffre_biometric.xml" />
    </device-transfer>
</data-extraction-rules>
